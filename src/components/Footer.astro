---
import Icon from './Icon.astro';
import ContractAddress from './ContractAddress.astro';
import PumpPill from './PumpPill.astro';
import { LINKS, NAV, TOKEN } from '../config';
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-ink text-white">
  <div class="h-2 bg-[linear-gradient(90deg,#ff5fa2,#ff8c42,#ffd23f,#bef264,#4cc9f0,#9b5de5)]" aria-hidden="true"></div>
  <div class="bg-confetti pointer-events-none absolute inset-0 opacity-30"></div>
  <PumpPill class="absolute right-6 top-10 size-16 animate-float-slow opacity-80" />
  <PumpPill class="absolute bottom-24 left-[45%] hidden size-10 animate-wiggle opacity-70 md:block" color="#ff5fa2" />
  <div class="container-x relative grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="space-y-4">
      <a href="/" class="inline-flex items-center gap-2.5">
        <img src="/logo-72.webp" alt="" width="36" height="36" class="size-9 rounded-full bg-white" />
        <span class="font-display text-xl font-bold tracking-tight">REFERRAL <span class="text-candy-lime">CODE</span></span>
      </a>
      <p class="max-w-sm text-sm text-white/70">Community-owned meme coin on Solana. No team allocation, no presale, authorities revoked on-chain.</p>
      <ContractAddress size="sm" />
    </div>
    <div>
      <h2 class="mb-3 text-sm font-bold uppercase tracking-widest text-candy-yellow">Explore</h2>
      <ul class="space-y-0.5 text-sm">
        {NAV.map((l) => <li><a href={l.href} class="inline-flex min-h-10 items-center text-white/80 hover:text-candy-lime">{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="mb-3 text-sm font-bold uppercase tracking-widest text-candy-sky">Community & data</h2>
      <ul class="space-y-0.5 text-sm">
        <li><a href={LINKS.x} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center gap-2 text-white/80 hover:text-candy-lime"><Icon name="x" class="size-3.5" /> {LINKS.xHandle}</a></li>
        <li><a href={LINKS.xCommunity} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center gap-2 text-white/80 hover:text-candy-lime"><Icon name="x" class="size-3.5" /> X Community</a></li>
        <li><a href={LINKS.dexscreener} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center text-white/80 hover:text-candy-lime">DexScreener</a></li>
        <li><a href={LINKS.geckoterminal} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center text-white/80 hover:text-candy-lime">GeckoTerminal</a></li>
        <li><a href={LINKS.solscanToken} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center text-white/80 hover:text-candy-lime">Solscan</a></li>
      </ul>
    </div>
  </div>
  <div class="relative border-t border-white/10">
    <p class="container-x py-8 text-xs leading-relaxed text-white/50">
      <strong class="text-white/80">Disclaimer:</strong> {TOKEN.ticker} is a meme coin with no intrinsic value or expectation of financial return. It is for entertainment only.
      Crypto assets are highly volatile and you can lose everything you put in. Nothing on this site is financial advice. Always do your own research.
      Live figures come from third-party sources (DexScreener, GeckoTerminal, Solana RPC) and may be delayed or wrong. © {year} Referral Code community.
    </p>
  </div>
</footer>
