---
import Icon from './Icon.astro';

// Static snapshots of the posts (text + images self-hosted in /public/x) — no X widget script.
const pumpfun = {
  url: 'https://x.com/Pumpfun/status/2111167411647099077',
  name: 'Pump.fun',
  handle: 'Pumpfun',
  avatar: '/x/pumpfun.jpg',
  avatarShape: 'rounded-xl',
  date: 'Oct 16, 2026',
  text: 'The MOST REWARDING referral program in crypto’s history.\n\nWe’re giving away ALL of the Pumpfun App’s revenue via rewards!\n\n- Your referral deposits $50 → both of you get $50 on top\n- ~10% reduced fees for your referrals\n- Referrers get a limited-time 4x boost\n\nLearn more 👇',
};

const alon = {
  url: 'https://x.com/a1lon9/status/2111518969324577087',
  name: 'alon',
  handle: 'a1lon9',
  avatar: '/x/alon.jpg',
  avatarShape: 'rounded-full',
  date: 'Oct 17, 2026',
  text: 'Why referrals have to place trades to receive up to $50 deposit matches\n\nOur goal isn’t to get downloads, our goal is to RETAIN new users who can benefit every single one of you who shows up every day…',
};

const json = {
  url: 'https://x.com/json1444/status/2111524613104828475',
  name: 'json',
  handle: 'json1444',
  avatar: '/x/json.jpg',
  avatarShape: 'rounded-full',
  date: 'Oct 17, 2026',
  text: 'TL;DR\n\n- new users mean nothing if they don’t stay in the ecosystem(!)\n- it’s incredibly easy for your referral to hit the deposit match, and better for you as a pump user\n- even if they don’t trade for the full 5 days, you both still get something\n- available worldwide(ish)',
};

const posts = [
  { ...pumpfun, media: true, quote: null, cta: 'Watch on X', sticker: '$50 + $50 💸', tilt: 'md:-rotate-1' },
  { ...alon, media: false, quote: null, cta: 'Read the full post', sticker: 'RETAIN 🫡', tilt: 'md:rotate-1' },
  { ...json, media: false, quote: alon, cta: 'Read on X', sticker: 'TL;DR 🧠', tilt: 'md:-rotate-[0.5deg]' },
];
---
<section id="on-x" class="section bg-brand-50/60">
  <div class="container-x">
    <div class="max-w-2xl" data-reveal>
      <span class="eyebrow"><Icon name="x" class="size-3" /> Seen on X</span>
      <h2 class="h-section mt-4">Referrals are the meta now.</h2>
      <p class="lede">Pump.fun launched what it calls the most rewarding referral program in crypto, Alon explained why it's built for retention, and json boiled it down to a TL;DR. The whole timeline is typing "referral code." We already own the name.</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <a href={p.url} target="_blank" rel="noopener noreferrer" class={`card card-lift group relative flex flex-col transition hover:rotate-0 ${p.tilt}`} data-reveal aria-label={`Read ${p.name}'s post on X`}>
          <span class="absolute -top-3 right-5 rotate-3 rounded-lg border-2 border-ink bg-lime-300 px-2.5 py-0.5 font-display text-sm font-bold shadow-[3px_3px_0_#0b1a10] transition group-hover:-rotate-3 group-hover:scale-110" aria-hidden="true">{p.sticker}</span>
          <div class="flex items-center gap-3">
            <img src={p.avatar} alt="" width="48" height="48" loading="lazy" decoding="async" class={`size-12 shrink-0 ${p.avatarShape} border border-gray-200 object-cover`} />
            <div class="min-w-0 flex-1 leading-tight">
              <div class="truncate font-semibold">{p.name}</div>
              <div class="truncate text-sm text-gray-500">@{p.handle} · {p.date}</div>
            </div>
            <Icon name="x" class="size-5 shrink-0 text-gray-900" />
          </div>

          <p class="mt-5 whitespace-pre-line text-[15px] leading-relaxed text-gray-800">{p.text}</p>

          {p.media && (
            <div class="relative mt-5 aspect-video overflow-hidden rounded-2xl border border-gray-200 bg-white">
              <img src="/x/pumpfun-video.jpg" alt="Pump.fun referral program video" width="1200" height="675" loading="lazy" decoding="async" class="size-full object-cover transition duration-500 group-hover:scale-[1.03]" />
              <span class="absolute inset-0 grid place-items-center">
                <span class="grid size-14 place-items-center rounded-full bg-brand-700 text-white shadow-lg shadow-brand-700/30 transition group-hover:scale-110"><Icon name="Play" class="ml-0.5 size-6 fill-current" /></span>
              </span>
              <span class="absolute bottom-3 left-3 rounded-md bg-black/70 px-1.5 py-0.5 font-mono text-xs text-white">0:33</span>
            </div>
          )}

          {p.quote && (
            <div class="mt-5 rounded-2xl border border-gray-200 bg-gray-50/80 p-4">
              <div class="flex items-center gap-2 text-sm">
                <img src={p.quote.avatar} alt="" width="20" height="20" loading="lazy" decoding="async" class="size-5 rounded-full" />
                <span class="font-semibold">{p.quote.name}</span>
                <span class="truncate text-gray-500">@{p.quote.handle}</span>
              </div>
              <p class="mt-1.5 line-clamp-2 text-sm text-gray-700">Why referrals have to place trades to receive up to $50 deposit matches</p>
            </div>
          )}

          <span class="mt-auto inline-flex items-center gap-2 pt-6 font-semibold text-brand-800">{p.cta} <Icon name="ArrowUpRight" class="size-4 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5" /></span>
        </a>
      ))}
    </div>

    <!-- X header download -->
    <div class="mt-12 overflow-hidden rounded-3xl border-4 border-ink bg-white shadow-[8px_8px_0_#0b1a10]" data-reveal>
      <img src="/x-banner.png" alt="$REFERRAL × Pump.fun X header featuring the Pump.fun, alon and json referral posts" width="1500" height="500" loading="lazy" decoding="async" class="block w-full" />
      <div class="flex flex-col items-start gap-4 border-t-4 border-ink p-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="font-display text-xl font-bold">Rep the code on your profile</div>
          <p class="text-sm text-gray-600">1500×500 X header. Download it, set it as your banner, become a walking referral link.</p>
        </div>
        <a href="/x-banner.png" download="referral-x-header.png" data-banner-dl class="btn-primary shrink-0"><Icon name="Download" class="size-5" /> Download header</a>
      </div>
    </div>

    <p class="mt-6 text-xs text-gray-500">Posts shown for context and link to the originals on X. $REFERRAL is a community token and is not affiliated with Pump.fun.</p>
  </div>
</section>

<script>
  import { confetti } from '../lib/fun';
  document.querySelector('[data-banner-dl]')?.addEventListener('click', (e) => confetti(e.currentTarget as Element));
</script>
