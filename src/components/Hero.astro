---
import Icon from './Icon.astro';
import ContractAddress from './ContractAddress.astro';
---
<section class="relative isolate overflow-hidden pt-[72px]">
  <div class="bg-grid absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_75%)]"></div>
  <div class="absolute -top-40 right-[-10%] -z-10 size-[560px] rounded-full bg-brand-400/25 blur-3xl"></div>

  <div class="container-x grid items-center gap-12 py-14 lg:min-h-[calc(100dvh-72px)] lg:grid-cols-[1.1fr_1fr] lg:py-20">
    <div class="space-y-7">
      <h1 class="font-display text-5xl font-bold leading-[0.95] tracking-tighter text-balance sm:text-6xl lg:text-7xl">
        All you need is <span class="block text-brand-700">one referral code.</span>
      </h1>

      <p class="max-w-xl text-lg text-pretty text-gray-600 sm:text-xl">
        $REFERRAL is the meme coin built on the oldest trick in the internet book: share your code.
        Every holder is a referrer, and every referral fuels the next wave.
      </p>

      <ContractAddress />

      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="#buy" class="btn-primary min-h-14 px-8 text-lg">Buy $REFERRAL <Icon name="ArrowRight" class="size-5" /></a>
        <a href="/share" class="btn-ghost min-h-14 px-8 text-lg"><Icon name="Sparkles" class="size-5 text-brand-700" /> Make your referral card</a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-[420px]">
      <div class="relative aspect-square rounded-full bg-gradient-to-br from-brand-500 to-brand-800 p-4 shadow-2xl shadow-brand-700/30 sm:p-5">
        <div class="absolute inset-3 rounded-full bg-white/20 blur-md"></div>
        <picture>
          <source srcset="/logo.webp" type="image/webp" />
          <img src="/logo.png" alt="Referral Code logo" width="400" height="400" fetchpriority="high" class="relative size-full rounded-full bg-white object-contain p-3" />
        </picture>
      </div>

      <!-- Live price chip, filled by the Live section's market feed -->
      <div class="absolute -bottom-4 left-1/2 w-max -translate-x-1/2 rounded-2xl border border-gray-200 bg-white/95 px-5 py-3 shadow-xl backdrop-blur sm:-left-6 sm:bottom-10 sm:translate-x-0">
        <div class="text-[11px] font-semibold uppercase tracking-widest text-gray-500">$REFERRAL price</div>
        <div class="flex items-baseline gap-2">
          <span data-hero-price class="font-display text-2xl font-bold tabular-nums">—</span>
          <span data-hero-change class="text-sm font-semibold tabular-nums text-gray-400"></span>
        </div>
      </div>
      <div class="absolute -right-2 top-6 hidden rounded-2xl border border-gray-200 bg-white/95 px-4 py-2.5 shadow-xl backdrop-blur sm:block">
        <div class="flex items-center gap-2 text-sm font-semibold"><Icon name="ShieldCheck" class="size-4 text-brand-700" /> Mint & freeze revoked</div>
      </div>
    </div>
  </div>
</section>

<script>
  import { price, pct } from '../lib/format';
  import type { Market } from '../lib/market';
  const p = document.querySelector('[data-hero-price]');
  const c = document.querySelector('[data-hero-change]');
  window.addEventListener('market', (e) => {
    const m = (e as CustomEvent<Market>).detail;
    if (p) p.textContent = price(m.priceUsd);
    if (c && m.change.h24 !== null) {
      c.textContent = `${pct(m.change.h24)} 24h`;
      c.className = `text-sm font-semibold tabular-nums ${m.change.h24 >= 0 ? 'text-brand-700' : 'text-red-600'}`;
    }
  });
</script>
