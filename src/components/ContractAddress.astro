---
import Icon from './Icon.astro';
import { TOKEN } from '../config';
interface Props { size?: 'sm' | 'lg' }
const { size = 'lg' } = Astro.props;
---
<button
  type="button"
  data-copy-ca
  class:list={[
    'group flex w-full items-center gap-3 rounded-2xl border border-gray-300 bg-white text-left transition hover:border-brand-500',
    size === 'lg' ? 'p-4 sm:p-5' : 'max-w-sm p-3',
  ]}
  aria-label={`Copy contract address ${TOKEN.mint}`}
>
  <span class="min-w-0 flex-1">
    <span class="block text-[11px] font-semibold uppercase tracking-widest text-gray-500">Contract address</span>
    <span class:list={['block break-all font-mono text-gray-900', size === 'lg' ? 'text-sm sm:text-base' : 'text-xs']}>{TOKEN.mint}</span>
  </span>
  <span class="flex shrink-0 items-center gap-1.5 rounded-xl bg-brand-50 px-3 py-2 text-sm font-semibold text-brand-800 group-hover:bg-brand-100">
    <Icon name="Copy" class="size-4" /> Copy
  </span>
</button>

<script>
  import { copyText, toast } from '../lib/ui';
  import { TOKEN } from '../config';
  document.querySelectorAll<HTMLButtonElement>('[data-copy-ca]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const ok = await copyText(TOKEN.mint);
      toast(ok ? 'Contract address copied' : 'Copy failed. Long-press the address to copy it.', ok ? 'ok' : 'error');
    });
  });
</script>
