---
// Pump.fun-style pill, drawn as SVG so it floats on any background.
interface Props { class?: string; color?: string; label?: string }
const { class: cls = 'size-12', color = '#5fcf8a', label } = Astro.props;

---
<svg viewBox="0 0 100 100" class={cls} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <g transform="rotate(-45 50 50)">
    <rect x="8" y="30" width="84" height="40" rx="20" fill="#fff" stroke="#1f3b33" stroke-width="6" />
    <path d="M28 30h22v40H28a20 20 0 0 1 0-40z" fill={color} />
    <rect x="8" y="30" width="84" height="40" rx="20" fill="none" stroke="#1f3b33" stroke-width="6" />
    <line x1="50" y1="30" x2="50" y2="70" stroke="#1f3b33" stroke-width="6" />
    <path d="M19 44v6M19 54v1" stroke="#fff" stroke-width="3.5" stroke-linecap="round" />
    <path d="M78 40q6 4 6 10" stroke="#cbd5d1" stroke-width="4" fill="none" stroke-linecap="round" />
  </g>
</svg>
