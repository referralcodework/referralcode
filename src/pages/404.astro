---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found • $REFERRAL">
  <section class="grid min-h-[80dvh] place-items-center pt-[72px]">
    <div class="container-x text-center">
      <div class="font-display text-8xl font-bold text-brand-700">404</div>
      <h1 class="mt-4 font-display text-3xl font-bold">This referral link leads nowhere.</h1>
      <p class="mt-3 text-gray-600">The page you're looking for doesn't exist, but the coin does.</p>
      <a href="/" class="btn-primary mt-8">Back to home <Icon name="ArrowRight" class="size-5" /></a>
    </div>
  </section>
</Base>
